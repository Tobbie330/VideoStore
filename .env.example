# Copy to .env and fill in before running `docker compose up -d`.

# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# First admin account (created on first start only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-now

# Set to 1 when running behind a reverse proxy that terminates HTTPS
# (Caddy, nginx, Cloudflare Tunnel...). Enables secure cookies.
TRUST_PROXY=0

# Largest upload in MB. Keep <= the limits in docker/clamd.conf.
MAX_UPLOAD_MB=4000

# Only "demo" exists today (premium granted without charge).
PAYMENT_MODE=demo
