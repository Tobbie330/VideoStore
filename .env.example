# Copy to .env and fill in before running `docker compose up -d`.

# Your domain (DNS must point at this server). Caddy gets the HTTPS certificate.
DOMAIN=videos.example.com

# Long random string: run `openssl rand -hex 32`
SESSION_SECRET=

# Encrypts creators' ID documents and release forms. Run `openssl rand -hex 32`.
# KEEP A COPY SOMEWHERE SAFE (password manager): without it those documents
# can't be opened, and they're legal records you must keep.
DOCS_ENCRYPTION_KEY=

# First admin account (created on first start only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-now

# Number of proxies in front of the app: 1 = Caddy only (default in docker-compose).
TRUST_PROXY=1

# If Cloudflare is in front of the site, uncomment so login rate-limits use the
# visitor's real IP. (Region blocking reads Cloudflare's location headers.)
# CLIENT_IP_HEADER=cf-connecting-ip

# Largest upload in MB. Keep <= the limits in docker/clamd.conf.
MAX_UPLOAD_MB=4000

# How many daily database snapshots to keep in ./backups
BACKUP_KEEP=14

# Only "demo" exists today (premium granted without charge).
PAYMENT_MODE=demo
