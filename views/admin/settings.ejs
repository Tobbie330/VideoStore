<%- include('../partials/head') %>
<%- include('_nav') %>
<h1>Settings</h1>
<form method="post" action="/admin/settings" class="form panel">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Site name <input name="site_name" value="<%= settings.site_name %>" required></label>
  <label class="check"><input type="checkbox" name="hide_ads_for_subscribers" value="yes" <%= settings.hide_ads_for_subscribers === '1' ? 'checked' : '' %>> Hide ads for premium subscribers</label>
  <label class="check"><input type="checkbox" name="creator_applications_open" value="yes" <%= settings.creator_applications_open === '1' ? 'checked' : '' %>> Accept new creator applications (ID-verified)</label>
  <p class="muted small">Every upload from a creator waits in the review queue until an admin approves it.</p>

  <h2>Business details <small class="muted">— shown on the legal pages</small></h2>
  <div class="row">
    <label>Legal business name <input name="business_name" value="<%= settings.business_name %>" placeholder="Your Company LLC"></label>
    <label>Contact / abuse email <input name="contact_email" type="email" value="<%= settings.contact_email %>" placeholder="support@yourdomain.com"></label>
  </div>
  <label>Business address <input name="business_address" value="<%= settings.business_address %>"></label>
  <div class="row">
    <label>2257 custodian of records — name <input name="custodian_name" value="<%= settings.custodian_name %>"></label>
    <label>Custodian address <textarea name="custodian_address" rows="2"><%= settings.custodian_address %></textarea></label>
  </div>

  <h2>Blocked regions <small class="muted">— for places that require ID-based age checks</small></h2>
  <label>Countries or US states to block
    <input name="blocked_regions" value="<%= settings.blocked_regions %>" placeholder="e.g. US-TX, US-UT, GB">
    <small class="muted">Comma-separated codes: a country (<code>GB</code>, <code>FR</code>) or a country-state (<code>US-TX</code>).
      Visitors from these places see a "not available in your region" page. Needs Cloudflare in front of the site with
      "Add visitor location headers" turned on, and <code>TRUST_PROXY=1</code>.
      <% if (!locals.geoActive) { %><strong class="warn">Location headers are not being read right now (TRUST_PROXY is off), so nobody is blocked.</strong><% } %></small>
  </label>
  <button class="btn btn-primary">Save settings</button>
</form>

<h2>Subscription plans</h2>
<p class="muted">Payment mode: <strong><%= paymentMode %></strong><%= paymentMode === 'demo' ? ' — subscriptions activate instantly with no charge.' : '' %></p>
<table class="table">
  <tr><th>Name</th><th>Price ($)</th><th>Days</th><th>Status</th><th></th></tr>
  <% plans.forEach(function (p) { %>
  <% var f = 'plan-' + p.id; %>
  <tr class="<%= p.active ? '' : 'inactive' %>">
    <td><input form="<%= f %>" name="name" value="<%= p.name %>"></td>
    <td><input form="<%= f %>" name="price" type="number" step="0.01" min="0" value="<%= (p.price_cents / 100).toFixed(2) %>"></td>
    <td><input form="<%= f %>" name="days" type="number" min="1" value="<%= p.days %>"></td>
    <td><%= p.active ? 'active' : 'hidden' %></td>
    <td class="actions"><form id="<%= f %>" method="post" action="/admin/plans">
      <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= p.id %>">
      <button class="btn btn-sm" name="action" value="save"><%= p.active ? 'Save' : 'Save & re-enable' %></button><% if (p.active) { %><button class="btn btn-sm btn-danger" name="action" value="delete">Hide</button><% } %>
    </form></td>
  </tr>
  <% }) %>
  <tr>
    <td><input form="plan-new" name="name" placeholder="New plan"></td>
    <td><input form="plan-new" name="price" type="number" step="0.01" min="0" placeholder="9.99"></td>
    <td><input form="plan-new" name="days" type="number" min="1" placeholder="30"></td>
    <td></td><td><form id="plan-new" method="post" action="/admin/plans"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-primary">Add plan</button></form></td>
  </tr>
</table>
<%- include('../partials/foot') %>
